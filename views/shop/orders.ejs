<%- include('../includes/head.ejs') %>
  </head>
  <body>
    <%- include('../includes/navigation.ejs') %>
    <main>
      <% if (orders.length <= 0) { %>
        <h1>Nothing there!</h1>
      <% } else { %>
        <h1>Your Orders</h1>
        <ul>
          <% orders.forEach(order => { %>
            <li>
              <h2>Order <%= order.id %></h2>
              <ul>
                <% order.products.forEach(product => { %>
                  <li>
                    <h3><%= product.title %> (<%= product.orderItem.quantity %>)</h3>
                  </li>
                <% }) %>
              </ul>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
    <%- include('../includes/end.ejs') %>