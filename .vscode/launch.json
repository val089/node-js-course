{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\src\\routes.ts",
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "restart": true, // this is the important part to restart the debugger, it will restart the debugger
      "runtimeExecutable": "nodemon", // this is the important part to restart the debugger, it will use nodemon to restart the debugger
      "console": "integratedTerminal" // this is the important part to restart the debugger, it will open the terminal in vscode; always use it if you use runtimeExecutable": "nodemon"
    }
  ]
}
